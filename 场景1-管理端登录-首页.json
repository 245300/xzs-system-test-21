                  "pm.test('业务码为 1', function () { pm.expect(body.code).to.equal(1); });",
                  "pm.test('返回 admin', function () { pm.expect(body.response.userName).to.equal('admin'); });",
                  "pm.test('提示成功', function () { pm.expect(body.message).to.include('成功'); });"
                ]
              }
            }
