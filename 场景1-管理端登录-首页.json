{
  "apifoxCli": "1.1",
  "info": {
    "name": "场景一：管理端登录-首页接口测试",
    "description": "覆盖未登录拦截、错误密码、管理员登录、首页统计、当前用户与操作日志。"
  },
  "name": "场景一：管理端登录-首页接口测试",
  "item": [
    {
      "name": "场景一：管理端登录-首页接口测试",
      "item": [
        {
          "name": "01-未登录访问管理端首页被拦截",
          "metaInfo": {
            "type": "http"
          },
          "request": {
            "method": "POST",
            "url": "http://127.0.0.1:8065/api/admin/dashboard/index",
            "headers": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "request-ajax",
                "value": "true"
              },
              {
                "key": "User-Agent",
                "value": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/157.0.0.0 Safari/537.36"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.request.headers.upsert({key:'Content-Type', value:'application/json'});",
                  "pm.variables.set('adminName', 'admin');",
                  "pm.variables.set('adminPwd', '123456');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "pm.test('未登录业务码 401', function () { pm.expect(body.code).to.equal(401); });",
                  "pm.test('提示未登录', function () { pm.expect(body.message).to.include('未登录'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "02-错误密码登录被拒绝",
          "metaInfo": {
            "type": "http"
          },
          "request": {
            "method": "POST",
            "url": "http://127.0.0.1:8065/api/user/login",
