      "description": "覆盖未登录拦截、学生/管理员分页、学科列表、试卷与题目分页、题目详情。"
    },
    "name": "场景三：管理端登录-用户与卷题管理接口测试",
    "item": [
      {
        "name": "场景三：管理端登录-用户与卷题管理接口测试",
        "item": [
          {
            "name": "01-未登录访问学生列表被拦截",
            "metaInfo": {
              "type": "http"
            },
            "request": {
              "method": "POST",
              "url": "http://127.0.0.1:8065/api/admin/user/page/list",
              "headers": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                },
                {
                  "key": "request-ajax",
                  "value": "true"
                },
                {
                  "key": "User-Agent",
                  "value": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/157.0.0.0 Safari/537.36"
                }
              ],
              "body": {
                "mode": "raw",
                "raw": "{\"userName\":\"\",\"role\":1,\"pageIndex\":1,\"pageSize\":10}"
              }
            },
            "event": [
              {
                "listen": "prerequest",
                "script": {
                  "type": "text/javascript",
                  "exec": [
                    "pm.request.headers.upsert({key:'Content-Type', value:'application/json'});",
                    "pm.variables.set('adminName', 'admin');",
                    "pm.variables.set('adminPwd', '123456');"
                  ]
                }
              },
              {
                "listen": "test",
                "script": {
                  "type": "text/javascript",
                  "exec": [
                    "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
                    "const body = pm.response.json();",
                    "pm.test('未登录业务码 401', function () { pm.expect(body.code).to.equal(401); });",
                    "pm.test('提示未登录', function () { pm.expect(body.message).to.include('未登录'); });"
                  ]
                }
              }
            ]
          },
